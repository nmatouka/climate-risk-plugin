{
  "manifest_version": 3,
  "name": "Climate Risk - California",
  "version": "1.4.0",
  "description": "See wildfire, flood, heat & climate risks for California homes — on Zillow, Redfin, Realtor.com, Trulia & more.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "*://www.zillow.com/*",
    "*://www.realtor.com/*",
    "*://www.redfin.com/*",
    "*://www.trulia.com/*",
    "*://www.compass.com/*",
    "*://www.homes.com/*",
    "https://api.cal-adapt.org/*",
    "https://services.gis.ca.gov/*",
    "https://nominatim.openstreetmap.org/*",
    "https://nmatouka.github.io/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Climate Risk - California"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
