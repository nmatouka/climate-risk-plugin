{
  "manifest_version": 3,
  "name": "Climate Risk for Zillow - California",
  "version": "1.2.0",
  "description": "Educational climate risk information for California properties on Zillow",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.zillow.com/*",
    "*://*.zillowstatic.com/*",
    "https://api.cal-adapt.org/*",
    "https://osfm.fire.ca.gov/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.zillow.com/*"],
      "js": [
        "utils/cache.js",
        "utils/dataFetcher.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Climate Risk for Zillow"
  }
}
